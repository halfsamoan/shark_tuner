<?xml version="1.0" encoding="utf-8"?>
<!-- SharkTune home-screen widget with the fin-and-wave brand mark. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tuner_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/tuner_widget_bg"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_sharktune_mark"
        android:contentDescription="SharkTune" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="튜닝하기"
        android:textColor="#E6EFE8"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
