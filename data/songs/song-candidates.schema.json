{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toauner.app/schema/song-candidates.v1.json",
  "title": "toauner song curation candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedFrom", "shippingEligible", "songs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedFrom": { "type": "string", "minLength": 1 },
    "shippingEligible": { "const": false },
    "songs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/song" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url", "checkedAt", "checkedBy"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "checkedAt": { "type": "string", "format": "date" },
        "checkedBy": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["independent_reference", "curation_oracle"] },
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["tuning", "capo_fret", "cents_offset"] }
        }
      }
    },
    "song": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artist",
        "searchAliases",
        "title",
        "tuningId",
        "tuningVersion",
        "capoFret",
        "centsOffset",
        "researchConfidence",
        "verificationStatus",
        "sources",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "artist": { "type": "string", "minLength": 1 },
        "searchAliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "title": { "type": "string", "minLength": 1 },
        "musicBrainzRecordingMbid": { "type": "string", "format": "uuid" },
        "tuningId": { "type": "string", "minLength": 1 },
        "tuningVersion": { "type": "integer", "minimum": 1 },
        "capoFret": { "type": "integer", "minimum": 0, "maximum": 24 },
        "centsOffset": { "type": "number", "minimum": -100, "maximum": 100 },
        "researchConfidence": {
          "enum": ["web_verified", "high", "medium"]
        },
        "verificationStatus": {
          "enum": ["needs_human_review", "verified"]
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "verificationStatus": { "const": "verified" } },
            "required": ["verificationStatus"]
          },
          "then": {
            "properties": { "sources": { "minItems": 2 } }
          }
        }
      ]
    }
  }
}
